# =============================================================================
# Advocate-Chambers Platform Environment Configuration Template
# =============================================================================

# Application Environment (development | staging | production)
ENV=development

# Database Configuration (PostgreSQL in production, SQLite fallback in local dev)
DATABASE_URL=postgresql://advocate:advocate_password@localhost:5432/advocate_chambers

# Redis / RQ Worker Queue
REDIS_URL=redis://localhost:6379/0

# Authentication & Tenancy (Phase 4)
AUTH_DISABLED=false
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
AUTH_CLOCK_SKEW_SECONDS=60

# OIDC Identity Provider (Keycloak / Auth0 / Okta)
OIDC_ISSUER=https://auth.example.com/realms/advocate-chambers
OIDC_AUDIENCE=advocate-chambers-api
OIDC_JWKS_URL=https://auth.example.com/realms/advocate-chambers/protocol/openid-connect/certs

# Observability & OpenTelemetry (Phase 13)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=advocate-chambers-api

# AI Infrastructure & Archi-Copilot Integration (Phase 14-18)
# Google Gemini API Key for Brief Analysis, Scoring, and Suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
