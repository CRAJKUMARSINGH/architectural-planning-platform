# =============================================================================
# Architectural Planning Platform — OIDC / Identity Provider Deployment Environment Configuration
# =============================================================================
# This configuration is used for production and staging deployments integrating
# with an OpenID Connect (OIDC) identity provider (Keycloak, Auth0, Okta, etc.)
# -----------------------------------------------------------------------------

# Application Environment (staging | production | prod)
ENV=production

# Authentication Enforcement
# MUST be false in staging and production
AUTH_DISABLED=false

# OIDC Issuer URL (e.g. Keycloak realm, Auth0 tenant)
# Example: https://auth.example.com/realms/architectural-planning-platform
OIDC_ISSUER=https://auth.example.com/realms/architectural-planning-platform

# OIDC Audience Expected in JWT (aud claim)
OIDC_AUDIENCE=architectural-planning-platform-api

# OIDC JSON Web Key Set (JWKS) URL for rotating public keys
# Example: https://auth.example.com/realms/architectural-planning-platform/protocol/openid-connect/certs
OIDC_JWKS_URL=https://auth.example.com/realms/architectural-planning-platform/protocol/openid-connect/certs

# Token Leeway / Clock Skew in Seconds (0 - 300)
AUTH_CLOCK_SKEW_SECONDS=60

# Keycloak Deployment Specifics (when running deploy/oidc/docker-compose.oidc.yml)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-in-production
KEYCLOAK_PORT=8080
KEYCLOAK_REALM_NAME=architectural-planning-platform
KEYCLOAK_CLIENT_ID=architectural-planning-platform-api

# Database connection for Keycloak backing store
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_HOST=keycloak-postgres
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-db-password
