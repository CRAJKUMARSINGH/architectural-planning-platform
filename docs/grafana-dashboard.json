{
  "__comment": "E07 Observability — Grafana dashboard. Import via Grafana UI: + → Import → paste JSON.",
  "title": "Architectural Planning Platform",
  "uid": "architectural-planning-platform-v1",
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6},
      "targets": [{"expr": "rate(http_requests_total[5m])", "legendFormat": "{{method}} {{path}} {{status}}"}]
    },
    {
      "id": 2,
      "title": "HTTP P95 Latency (s)",
      "type": "graph",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
      "targets": [{"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95 {{path}}"}]
    },
    {
      "id": 3,
      "title": "Job Queue Depth",
      "type": "stat",
      "gridPos": {"x": 0, "y": 6, "w": 6, "h": 4},
      "targets": [{"expr": "job_queue_depth", "legendFormat": "queued jobs"}]
    },
    {
      "id": 4,
      "title": "Validation Duration P95 (s)",
      "type": "graph",
      "gridPos": {"x": 6, "y": 6, "w": 18, "h": 4},
      "targets": [{"expr": "histogram_quantile(0.95, rate(validation_duration_seconds_bucket[5m]))", "legendFormat": "validation p95"}]
    },
    {
      "id": 5,
      "title": "Error Rate",
      "type": "graph",
      "gridPos": {"x": 0, "y": 10, "w": 24, "h": 6},
      "targets": [{"expr": "rate(http_requests_total{status=~'5..'}[5m])", "legendFormat": "5xx errors"}]
    }
  ],
  "refresh": "30s"
}
