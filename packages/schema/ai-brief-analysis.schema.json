{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://advocate-chambers.dev/schemas/ai-brief-analysis.v1.json",
  "title": "AI Brief Analysis",
  "description": "Structured analysis of client brief generated by AI",
  "type": "object",
  "version": "ai-brief-analysis.v1",
  "required": ["version", "summary", "spaceProgram", "constraints", "opportunities", "openQuestions", "provenance", "modelVersion"],
  "properties": {
    "version": {
      "type": "string",
      "const": "ai-brief-analysis.v1"
    },
    "summary": {
      "type": "string",
      "description": "Brief summary of the project"
    },
    "spaceProgram": {
      "type": "array",
      "description": "Room-by-room space program",
      "items": {
        "type": "object",
        "required": ["name", "sqm", "priority"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Space name"
          },
          "sqm": {
            "type": "number",
            "description": "Area in square meters"
          },
          "priority": {
            "type": "string",
            "enum": ["must-have", "nice-to-have"],
            "description": "Priority level"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes about the space"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "description": "Site and brief constraints",
      "items": {
        "type": "string"
      }
    },
    "opportunities": {
      "type": "array",
      "description": "Design opportunities identified",
      "items": {
        "type": "string"
      }
    },
    "openQuestions": {
      "type": "array",
      "description": "Questions to ask the client",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "description": "AI operation provenance tracking",
      "properties": {
        "model": {
          "type": "string",
          "description": "AI model used"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of analysis"
        },
        "briefLength": {
          "type": "integer",
          "description": "Length of original brief text"
        },
        "contextKeys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Context keys used in analysis"
        }
      }
    },
    "modelVersion": {
      "type": "string",
      "description": "AI model version used"
    }
  }
}