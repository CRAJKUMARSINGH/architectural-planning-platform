{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://advocate-chambers.local/schemas/render-manifest.schema.json",
  "title": "Advocate-Chambers Presentation Render Manifest v1",
  "description": "Deterministic inputs for a non-authoritative presentation render.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestId",
    "modelSha256",
    "rendererVersion",
    "styleVersion",
    "assetCatalogVersion",
    "camera",
    "output",
    "seed",
    "presentationOnly"
  ],
  "properties": {
    "schemaVersion": {
      "const": "advocate-chambers.render-manifest.v1"
    },
    "manifestId": {
      "type": "string",
      "minLength": 1
    },
    "modelSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rendererVersion": {
      "type": "string",
      "minLength": 1
    },
    "styleVersion": {
      "type": "string",
      "minLength": 1
    },
    "assetCatalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "projection"],
      "properties": {
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "string",
          "enum": ["orthographic", "perspective"]
        },
        "position": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        },
        "target": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"type": "number"}
        }
      }
    },
    "sectionPlane": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "height": {"type": "number"},
        "unit": {"type": "string", "enum": ["inch", "mm", "cm", "m"]}
      },
      "required": ["height", "unit"]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "width", "height", "mimeType"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["png", "jpeg", "webp", "glb", "svg", "pdf"]
        },
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "mimeType": {"type": "string", "minLength": 1}
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "presentationOnly": {
      "const": true
    }
  }
}