{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CRAJKUMARSINGH/architectural-planning-platform/blob/main/packages/schema/week21-performance-result.schema.json",
  "title": "Week 21 performance benchmark result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "profiles",
    "silentTimeouts",
    "outOfMemoryFailures",
    "dataLossEvents",
    "nondeterministicRuns"
  ],
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["small", "medium", "large"] }
    },
    "silentTimeouts": { "type": "integer", "minimum": 0 },
    "outOfMemoryFailures": { "type": "integer", "minimum": 0 },
    "dataLossEvents": { "type": "integer", "minimum": 0 },
    "nondeterministicRuns": { "type": "integer", "minimum": 0 },
    "measurements": { "type": "array", "items": { "type": "object" } }
  }
}