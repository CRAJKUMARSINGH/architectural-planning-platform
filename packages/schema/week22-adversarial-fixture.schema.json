{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CRAJKUMARSINGH/architectural-planning-platform/blob/main/packages/schema/week22-adversarial-fixture.schema.json",
  "title": "Week 22 adversarial architectural fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "title",
    "sourceFixture",
    "defect",
    "mutations",
    "expectedFinding"
  ],
  "properties": {
    "schemaVersion": { "const": "week22.adversarial-fixture.v1" },
    "fixtureId": { "type": "string", "pattern": "^ADV-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "sourceFixture": { "type": "string", "minLength": 1 },
    "defect": {
      "type": "object",
      "required": ["category", "severity", "description"],
      "properties": {
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["BLOCKER", "ERROR", "WARNING"] },
        "description": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "operation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "operation": { "enum": ["set", "remove", "append"] },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "expectedFinding": {
      "type": "object",
      "required": ["ruleId", "severity", "affectedObjects", "evidenceFields", "correction"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["BLOCKER", "ERROR", "WARNING"] },
        "affectedObjects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "evidenceFields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "correction": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}