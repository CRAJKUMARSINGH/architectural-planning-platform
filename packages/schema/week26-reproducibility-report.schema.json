{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CRAJKUMARSINGH/architectural-planning-platform/blob/main/packages/schema/week26-reproducibility-report.schema.json",
  "title": "Week 26 reproducibility and failure-recovery report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "packagePath",
    "applicationCommit",
    "rulePackVersion",
    "inputModelSha256",
    "modelSignature",
    "validationSignature",
    "manifestSignature",
    "rerun",
    "failureInjection",
    "revisionComparison",
    "acceptance",
    "status"
  ],
  "properties": {
    "version": { "const": "week26.reproducibility.v1" },
    "packagePath": { "type": "string", "minLength": 1 },
    "applicationCommit": { "type": "string", "minLength": 1 },
    "rulePackVersion": { "type": "string", "minLength": 1 },
    "inputModelSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "modelSignature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "validationSignature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "manifestSignature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "acceptance": { "type": "object" }
  }
}