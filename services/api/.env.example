# Local API default: SQLite at .data/architectural-planning-platform.sqlite3.
# Set this path for an isolated test or development database.
APP_DB_PATH=.data/architectural-planning-platform.sqlite3

# PostgreSQL deployment reference (the current API adapter still uses the
# SQLite implementation locally; apply services/api/schema.sql to this URL
# when the Postgres repository is introduced in the next persistence slice).
DATABASE_URL=postgresql://app:app-local-only@localhost:5432/architectural_planning_platform
