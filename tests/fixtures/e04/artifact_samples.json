{
  "_comment": "Content-addressed artifact fixtures for E04 SHA-256 integrity regression.",
  "artifacts": [
    {
      "id": "artifact-qg-report-01",
      "kind": "json-report",
      "filename": "quality-gate-report.json",
      "content": "{\"status\": \"REVIEW_REQUIRED\", \"adversarialSuite\": {\"detected\": 30, \"total\": 30}}",
      "expectedSha256": "expects-runtime-calculation",
      "sizeBytes": 79
    },
    {
      "id": "artifact-perf-report-01",
      "kind": "performance-report",
      "filename": "week25-performance-report.json",
      "content": "{\"status\": \"REVIEW_REQUIRED\", \"operations\": {\"validate\": {\"p50_ms\": 12, \"p95_ms\": 45}}}",
      "expectedSha256": "expects-runtime-calculation",
      "sizeBytes": 84
    },
    {
      "id": "artifact-adversarial-01",
      "kind": "adversarial-report",
      "filename": "week23-adversarial-expansion-report.json",
      "content": "{\"detected\": 30, \"total\": 30, \"falsenegatives\": 0}",
      "expectedSha256": "expects-runtime-calculation",
      "sizeBytes": 52
    }
  ],
  "securityCases": [
    {
      "id": "traversal-01",
      "description": "Path traversal attempt must be sanitized or rejected",
      "maliciousKey": "../../etc/passwd",
      "expectedBehaviour": "sanitized_or_rejected"
    },
    {
      "id": "traversal-02",
      "description": "Null-byte injection in key",
      "maliciousKey": "reports/valid\u0000../../etc/shadow",
      "expectedBehaviour": "sanitized_or_rejected"
    },
    {
      "id": "dedup-01",
      "description": "Same SHA-256 content written twice should return same hash",
      "expectedBehaviour": "idempotent"
    }
  ]
}
